# Salin file ini jadi .env di folder yang sama (DigiFusion/):
#   cp .env.example .env
#
# API_TOKEN — dari Agents → API (Create token).
# API_ENDPOINT — URL POST penuh dari DigiFusion, misalnya:
#   https://...run.app/api/v1/agents/<uuid>/chat
# Server /chat-token memakai endpoint embed-sessions (otomatis dari .../chat).

API_TOKEN=YOUR_API_TOKEN
API_ENDPOINT=https://ppn-rag-console-fe-dev-431311422997.asia-southeast2.run.app/api/v1/agents/YOUR_AGENT_UUID/chat
